+    this->post_activations_steer = [](const server_http_req & req) -> server_http_res_ptr {
+        auto res = std::make_unique<server_http_res>();
+        json body;
+        try { body = json::parse(req.body); }
+        catch (...) { res->status = 400; res->data = json({{"error","invalid JSON"}}).dump(); return res; }
+
+        json result;
+        if (body.value("clear", false)) {
+            g_activation_capture.clear_steering();
+            g_activation_capture.clear_add();
+            result["cleared"] = true;
+            res->data = result.dump();
+            return res;
+        }
+        if (body.value("clear_add", false)) {
+            g_activation_capture.clear_add();
+            result["cleared_add"] = true;
+            if (!body.contains("add") && !body.contains("layers")) {
+                result["steering"] = g_activation_capture.steering;   // projection mode untouched
+                res->data = result.dump();
+                return res;
+            }
+        }
+
+        // Additive steering: "add": [ {"layer": il, "scale": s,
+        //   "path": "<file of n_embd float32>" | "vector": [floats...] }, ... ]
+        // Vectors are multiplied by `scale` here and then ADDED to l_out at
+        // that layer on every decode step ("add_only_decode": false to also
+        // edit prefill). Replaces any previous entry for the same layer.
+        if (body.contains("add")) {
+            const int n_embd_a = g_activation_capture.n_embd;
+            int loaded_add = 0;
+            for (const auto & A : body["add"]) {
+                int il = A.value("layer", -1);
+                if (il < 0 || il >= g_activation_capture.n_layers) continue;
+                float scale = A.value("scale", 1.0f);
+                std::vector<float> v;
+                if (A.contains("vector") && A["vector"].is_array()) {
+                    v = A["vector"].get<std::vector<float>>();
+                } else if (A.contains("path")) {
+                    v.resize(n_embd_a);
+                    FILE * f = fopen(A["path"].get<std::string>().c_str(), "rb");
+                    if (!f) { v.clear(); } else {
+                        size_t got = fread(v.data(), sizeof(float), n_embd_a, f);
+                        fclose(f);
+                        if (got != (size_t) n_embd_a) v.clear();
+                    }
+                }
+                if ((int) v.size() != n_embd_a) {
+                    result["error"] = "add vector wrong size/unreadable at layer " + std::to_string(il);
+                    res->status = 400; res->data = result.dump(); return res;
+                }
+                for (auto & x : v) x *= scale;
+                g_activation_capture.set_add_layer(il, v.data());
+                loaded_add++;
+            }
+            g_activation_capture.add_only_decode = body.value("add_only_decode", true) ? 1 : 0;
+            g_activation_capture.add_active = body.value("add_enabled", true) && !g_activation_capture.add_vecs.empty();
+            result["add_layers_loaded"] = loaded_add;
+            result["add_active"] = g_activation_capture.add_active;
+            if (!body.contains("layers")) {
+                result["steering"] = g_activation_capture.steering;
+                res->data = result.dump();
+                return res;
+            }
+        }
+
+        auto read_floats = [](const std::string & path, size_t want) -> std::vector<float> {
+            std::vector<float> v(want);
+            FILE * f = fopen(path.c_str(), "rb");
+            if (!f) return {};
+            size_t got = fread(v.data(), sizeof(float), want, f);
+            fclose(f);
+            if (got != want) return {};
+            return v;
+        };
+
+        int loaded = 0;
+        const int n_embd = g_activation_capture.n_embd;
+        for (const auto & L : body.value("layers", json::array())) {
+            int il = L["layer"].get<int>();
+            int K  = L.value("k", 0);
+            int M  = L.value("m", 0);
+            std::vector<float> reg, world;
+            if (K > 0) {
+                reg = read_floats(L["dirs_path"].get<std::string>(), (size_t)K * n_embd);
+                if (reg.empty()) { result["error"] = "dirs_path read failed at layer " + std::to_string(il); res->status = 400; res->data = result.dump(); return res; }
+            }
+            if (M > 0 && L.contains("world_path")) {
+                world = read_floats(L["world_path"].get<std::string>(), (size_t)M * n_embd);
+            }
+            g_activation_capture.set_steer_layer(il, K>0?reg.data():nullptr, K,
+                                                 M>0&&!world.empty()?world.data():nullptr,
+                                                 world.empty()?0:M);
+            loaded++;
+        }
+        g_activation_capture.steer_alpha = body.value("alpha", 1.0f);
+        g_activation_capture.world_beta  = body.value("beta", 0.0f);
+        g_activation_capture.steer_only_ntok1 = body.value("only_decode", true) ? 1 : 0;
+        g_activation_capture.steering = body.value("enabled", true) && loaded > 0;
+
+        result["steering"] = g_activation_capture.steering;
+        result["layers_loaded"] = loaded;
+        result["alpha"] = g_activation_capture.steer_alpha;
+        result["beta"]  = g_activation_capture.world_beta;
+        res->data = result.dump();
+        return res;
+    };
 }
 
