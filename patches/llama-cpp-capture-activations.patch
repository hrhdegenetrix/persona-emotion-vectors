diff --git a/tools/server/activation_capture.h b/tools/server/activation_capture.h
new file mode 100644
index 000000000..538d07c07
--- /dev/null
+++ b/tools/server/activation_capture.h
@@ -0,0 +1,462 @@
+#pragma once
+
+// Activation capture for llama-server feature transparency
+// Hooks into ggml's eval callback to capture l_out tensors during inference
+//
+// Two modes:
+//   1. Live monitoring — stores per-layer mean activations in memory (original)
+//   2. Collection — streams per-token full activation vectors to a binary file for SAE training
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <mutex>
+#include <vector>
+#include <string>
+#include <map>
+#include <cstring>
+#include <cstdio>
+#include <chrono>
+#include <algorithm>
+#include <cmath>
+
+// Binary file format for collected activations:
+//   Header (16 bytes):
+//     magic:      "ACTV" (4 bytes)
+//     version:    uint32_t = 1
+//     n_embd:     uint32_t
+//     layer_idx:  uint32_t
+//   Records (repeated, no delimiter):
+//     float32[n_embd]  — one per token
+//
+// Read with numpy: np.fromfile(f, dtype=np.float32, offset=16).reshape(-1, n_embd)
+
+struct activation_capture {
+    std::mutex mtx;
+    bool enabled = false;
+    int n_layers = 0;
+    int n_embd = 0;
+
+    // --- Live monitoring mode ---
+    // Per-layer mean activations from the most recent decode
+    // layer_means[il] has size n_embd (mean across all tokens in the batch)
+    std::vector<std::vector<float>> layer_means;
+
+    // Timestamp of last capture (milliseconds since epoch)
+    int64_t last_capture_ms = 0;
+
+    // Number of tokens in the last captured batch
+    int last_n_tokens = 0;
+
+    // --- Collection mode (SAE training / FFN-intermediate extraction) ---
+    bool collecting = false;
+    int collect_layer = -1;         // which layer to collect from (-1 = none)
+    FILE * collect_file = nullptr;  // output file handle
+    int64_t collect_n_tokens = 0;   // total tokens written so far
+    std::string collect_tensor = ""; // tensor prefix to collect (empty = l_out, "ffn_swiglu" = FFN intermediate)
+    int collect_dim = 0;            // dimension of collected tensor (set from first captured tensor)
+
+    void init(int layers, int embd) {
+        std::lock_guard<std::mutex> lock(mtx);
+        n_layers = layers;
+        n_embd = embd;
+        layer_means.clear();
+        layer_means.resize(layers);
+    }
+
+    void store_layer_mean(int il, const float * data, int n_embd_actual, int n_tokens) {
+        if (il < 0 || il >= n_layers) return;
+
+        std::vector<float> mean(n_embd_actual, 0.0f);
+
+        // Mean across all tokens for this layer
+        for (int t = 0; t < n_tokens; t++) {
+            for (int j = 0; j < n_embd_actual; j++) {
+                mean[j] += data[t * n_embd_actual + j];
+            }
+        }
+        if (n_tokens > 0) {
+            for (int j = 0; j < n_embd_actual; j++) {
+                mean[j] /= (float)n_tokens;
+            }
+        }
+
+        std::lock_guard<std::mutex> lock(mtx);
+        layer_means[il] = std::move(mean);
+        last_n_tokens = n_tokens;
+
+        auto now = std::chrono::system_clock::now();
+        last_capture_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+            now.time_since_epoch()).count();
+    }
+
+    // Write per-token vectors to the collection file (called from callback)
+    void collect_tokens(int il, const float * data, int n_embd_actual, int n_tokens) {
+        if (il != collect_layer || !collect_file) return;
+
+        // Write raw float32 vectors — one per token, no framing
+        size_t written = fwrite(data, sizeof(float), (size_t)n_embd_actual * n_tokens, collect_file);
+        if (written == (size_t)n_embd_actual * n_tokens) {
+            collect_n_tokens += n_tokens;
+        }
+        // Flush periodically (every ~1000 tokens) to avoid data loss
+        if (collect_n_tokens % 1024 < n_tokens) {
+            fflush(collect_file);
+        }
+    }
+
+    // ---- Projection write-back steering ----
+    // Per-layer projection matrices: for target layer il, steer_dirs[il] holds
+    // K unit row-directions (each n_embd long, flattened K*n_embd). At decode
+    // time each token vector h has its component along those directions
+    // attenuated:  h' = h - steer_alpha * sum_k (dir_k . h) dir_k
+    // (subtract a chosen subspace). Optionally add world_dirs
+    // back at a small positive scale. This is a per-token subspace edit, not a
+    // static vector add.
+    bool steering = false;
+    float steer_alpha = 0.0f;
+    float world_beta  = 0.0f;
+    int   steer_only_ntok1 = 1;   // 1 = only edit single-token decode steps (skip prefill)
+    std::map<int, std::vector<float>> steer_dirs;   // il -> K*n_embd subspace dirs
+    std::map<int, int>                steer_k;      // il -> K
+    std::map<int, std::vector<float>> world_dirs;   // il -> M*n_embd world dirs
+    std::map<int, int>                world_m;      // il -> M
+
+    // Edit one batch's token buffer in place (data is [n_embd, n_tokens] row-major
+    // as [token][embd]). Called from the callback for target layers only.
+    bool apply_steer(int il, float * data, int dim, int n_tokens) {
+        if (!steering) return false;
+        auto it = steer_dirs.find(il);
+        if (it == steer_dirs.end() || dim != n_embd) return false;
+        const int K = steer_k[il];
+        const float * D = it->second.data();
+        const bool has_world = world_dirs.count(il) && world_beta != 0.0f;
+        const int M = has_world ? world_m[il] : 0;
+        const float * W = has_world ? world_dirs[il].data() : nullptr;
+        for (int t = 0; t < n_tokens; t++) {
+            float * h = data + (size_t)t * dim;
+            for (int k = 0; k < K; k++) {
+                const float * dk = D + (size_t)k * dim;
+                float dot = 0.0f;
+                for (int j = 0; j < dim; j++) dot += dk[j] * h[j];
+                const float s = steer_alpha * dot;
+                for (int j = 0; j < dim; j++) h[j] -= s * dk[j];
+            }
+            for (int m = 0; m < M; m++) {
+                const float * wm = W + (size_t)m * dim;
+                float dot = 0.0f;
+                for (int j = 0; j < dim; j++) dot += wm[j] * h[j];
+                // pull toward world subspace: add a fraction of its own unit dir
+                for (int j = 0; j < dim; j++) h[j] += world_beta * wm[j];
+                (void)dot;
+            }
+        }
+        return true;
+    }
+
+    void set_steer_layer(int il, const float * dirs, int K, const float * wdirs, int M) {
+        std::lock_guard<std::mutex> lock(mtx);
+        if (K > 0 && dirs) {
+            steer_dirs[il] = std::vector<float>(dirs, dirs + (size_t)K * n_embd);
+            steer_k[il] = K;
+        }
+        if (M > 0 && wdirs) {
+            world_dirs[il] = std::vector<float>(wdirs, wdirs + (size_t)M * n_embd);
+            world_m[il] = M;
+        }
+    }
+
+    void clear_steering() {
+        std::lock_guard<std::mutex> lock(mtx);
+        steering = false; steer_alpha = 0.0f; world_beta = 0.0f;
+        steer_dirs.clear(); steer_k.clear(); world_dirs.clear(); world_m.clear();
+    }
+
+    // ---- Additive steering ----
+    // h' = h + add_vecs[il]  (vectors arrive pre-scaled by the client; the
+    // paper's convention is strength * mean residual norm at that layer).
+    // Independent of the projection mode above; both may be active.
+    bool add_active = false;
+    int  add_only_decode = 1;                         // 1 = decode steps only (skip prefill)
+    std::map<int, std::vector<float>> add_vecs;       // il -> n_embd
+
+    void set_add_layer(int il, const float * v) {
+        std::lock_guard<std::mutex> lock(mtx);
+        add_vecs[il] = std::vector<float>(v, v + n_embd);
+    }
+    void clear_add() {
+        std::lock_guard<std::mutex> lock(mtx);
+        add_active = false; add_vecs.clear();
+    }
+    bool apply_add(int il, float * data, int dim, int n_tokens) {
+        if (!add_active || dim != n_embd) return false;
+        auto it = add_vecs.find(il);
+        if (it == add_vecs.end()) return false;
+        const float * v = it->second.data();
+        for (int t = 0; t < n_tokens; t++) {
+            float * h = data + (size_t)t * dim;
+            for (int j = 0; j < dim; j++) h[j] += v[j];
+        }
+        return true;
+    }
+
+    // ---- Per-response accumulation ----
+    // Mean residual-stream vector over the DECODED tokens of one request,
+    // per layer, optionally skipping the first `acc_skip` tokens (the paper
+    // averages from the 50th story token). Begun when the slot enters
+    // SLOT_STATE_GENERATING and ended in send_final_response, so the result
+    // rides back inside that request's own JSON — no cross-request race.
+    // Global accumulator: only meaningful with -np 1 (the server refuses it
+    // otherwise). Sums in double.
+    bool acc_active = false;
+    bool acc_prev_enabled = false;
+    int  acc_skip = 0;
+    std::vector<char>                acc_layer_on;   // n_layers flags
+    std::vector<std::vector<double>> acc_sums;       // n_layers x n_embd (empty until touched)
+    std::vector<int64_t>             acc_count;      // tokens accumulated per layer (after skip)
+    std::vector<int64_t>             acc_seen;       // decode tokens seen per layer (incl. skipped)
+
+    void acc_begin(int skip, const std::vector<int> & layers) {
+        std::lock_guard<std::mutex> lock(mtx);
+        acc_skip = skip < 0 ? 0 : skip;
+        acc_layer_on.assign(n_layers, layers.empty() ? 1 : 0);
+        for (int il : layers) if (il >= 0 && il < n_layers) acc_layer_on[il] = 1;
+        acc_sums.assign(n_layers, std::vector<double>());
+        acc_count.assign(n_layers, 0);
+        acc_seen.assign(n_layers, 0);
+        acc_prev_enabled = enabled;
+        enabled = true;      // the eval callback only observes l_out while enabled
+        acc_active = true;
+    }
+
+    // called from the callback for decode batches only (n_tokens == 1 normally;
+    // accepted multi-token drafts are averaged token by token)
+    void acc_add(int il, const float * data, int dim, int n_tokens) {
+        if (!acc_active || il < 0 || il >= n_layers || dim != n_embd) return;
+        if (!acc_layer_on[il]) return;
+        std::lock_guard<std::mutex> lock(mtx);
+        auto & sum = acc_sums[il];
+        for (int t = 0; t < n_tokens; t++) {
+            const int64_t seen = acc_seen[il]++;
+            if (seen < acc_skip) continue;
+            if (sum.empty()) sum.assign(dim, 0.0);
+            const float * h = data + (size_t)t * dim;
+            for (int j = 0; j < dim; j++) sum[j] += h[j];
+            acc_count[il]++;
+        }
+    }
+
+    // Returns {"n_layers", "n_embd", "skip", "n_tokens_seen", "n_tokens_used",
+    //          "layers": { "<il>": [mean floats...] }} and stops accumulating.
+    // Layers whose count is 0 (all tokens skipped) are omitted.
+    template <typename JSON>
+    JSON acc_end() {
+        std::lock_guard<std::mutex> lock(mtx);
+        JSON out;
+        out["n_layers"] = n_layers;
+        out["n_embd"]   = n_embd;
+        out["skip"]     = acc_skip;
+        int64_t seen = 0, used = 0;
+        JSON layers = JSON::object();
+        for (int il = 0; il < n_layers; il++) {
+            if (!acc_layer_on.empty() && !acc_layer_on[il]) continue;
+            seen = std::max(seen, acc_seen[il]);
+            used = std::max(used, acc_count[il]);
+            if (acc_count[il] <= 0 || acc_sums[il].empty()) continue;
+            std::vector<float> mean(n_embd);
+            const double inv = 1.0 / (double) acc_count[il];
+            for (int j = 0; j < n_embd; j++) mean[j] = (float)(acc_sums[il][j] * inv);
+            layers[std::to_string(il)] = mean;
+        }
+        out["n_tokens_seen"] = seen;
+        out["n_tokens_used"] = used;
+        out["layers"] = layers;
+        acc_active = false;
+        enabled = acc_prev_enabled;
+        acc_sums.clear(); acc_count.clear(); acc_seen.clear(); acc_layer_on.clear();
+        return out;
+    }
+
+    bool start_collection(int layer, const char * path, const char * tensor = nullptr) {
+        std::lock_guard<std::mutex> lock(mtx);
+        if (collecting) return false; // already collecting
+
+        if (layer < 0 || layer >= n_layers) return false;
+
+        FILE * f = fopen(path, "wb");
+        if (!f) return false;
+
+        // Determine dimension based on tensor type
+        // For FFN intermediates, dim is set from the first captured tensor (written as 0 initially, patched later)
+        // For l_out, dim is n_embd
+        bool is_ffn = (tensor && strlen(tensor) > 0);
+        uint32_t dim = is_ffn ? 0 : (uint32_t)n_embd;
+
+        // Write header
+        const char magic[4] = {'A', 'C', 'T', 'V'};
+        uint32_t version = 1;
+        uint32_t lidx = (uint32_t)layer;
+
+        fwrite(magic, 1, 4, f);
+        fwrite(&version, sizeof(uint32_t), 1, f);
+        fwrite(&dim, sizeof(uint32_t), 1, f);
+        fwrite(&lidx, sizeof(uint32_t), 1, f);
+
+        collect_file = f;
+        collect_layer = layer;
+        collect_n_tokens = 0;
+        collect_tensor = tensor ? tensor : "";
+        collect_dim = 0;
+        collecting = true;
+        // Also ensure capture is enabled so callback fires
+        enabled = true;
+
+        return true;
+    }
+
+    // Patch the binary header with correct dimension (called after first tensor capture for FFN mode)
+    void patch_header_dim(int dim) {
+        if (!collect_file) return;
+        long pos = ftell(collect_file);
+        fseek(collect_file, 8, SEEK_SET); // offset 8 = n_embd field
+        uint32_t d = (uint32_t)dim;
+        fwrite(&d, sizeof(uint32_t), 1, collect_file);
+        fseek(collect_file, pos, SEEK_SET);
+    }
+
+    bool stop_collection() {
+        std::lock_guard<std::mutex> lock(mtx);
+        if (!collecting) return false;
+
+        if (collect_file) {
+            fflush(collect_file);
+            fclose(collect_file);
+            collect_file = nullptr;
+        }
+        collecting = false;
+        collect_layer = -1;
+        return true;
+    }
+};
+
+// Global instance
+inline activation_capture g_activation_capture;
+
+// The eval callback — called for every tensor node during graph computation
+// When ask==true: return true if we want to observe this tensor (causes GPU->CPU copy)
+// When ask==false: tensor data is available for reading
+static bool activation_eval_callback(struct ggml_tensor * t, bool ask, void * user_data) {
+    (void)user_data;
+
+    // We care about layer output tensors — named differently by model architecture:
+    //   Most architectures:                        "l_out-{layer}"
+    //   Some newer architectures:                  "final_output-{layer}"
+    const bool is_lout = strncmp(t->name, "l_out", 5) == 0
+                       || strncmp(t->name, "final_output", 12) == 0;
+
+    // Check if this tensor matches the collection target (e.g., "ffn_swiglu-{layer}")
+    bool is_collect_target = false;
+    if (g_activation_capture.collecting && !g_activation_capture.collect_tensor.empty()) {
+        is_collect_target = strncmp(t->name, g_activation_capture.collect_tensor.c_str(),
+                                    g_activation_capture.collect_tensor.length()) == 0;
+    }
+
+    if (ask) {
+        // Steering needs the l_out tensor even when capture is disabled, so
+        // ask for it whenever steering targets this layer.
+        if ((g_activation_capture.steering || g_activation_capture.add_active) && is_lout) {
+            int il_a = -1;
+            const char * d = strchr(t->name, '-');
+            if (d) il_a = atoi(d + 1);
+            if (il_a >= 0 && ((g_activation_capture.steering && g_activation_capture.steer_dirs.count(il_a))
+                           || (g_activation_capture.add_active && g_activation_capture.add_vecs.count(il_a)))) {
+                return true;
+            }
+        }
+        if (!g_activation_capture.enabled) {
+            return false;
+        }
+        // Live monitoring only consumes decode-step activations (the stored
+        // state after a response is always the last generated token), so skip
+        // prompt-processing batches (n_tokens > 1) — every observed tensor is
+        // a graph split + GPU->CPU sync, and declining here keeps prefill
+        // fully fused. Collection mode still observes everything: SAE-style
+        // collection reads prompt-token activations too.
+        if (!g_activation_capture.collecting && t->ne[1] > 1) {
+            return false;
+        }
+        return is_lout || is_collect_target;
+    }
+
+    // ask == false: tensor data has been copied to CPU for us to read
+    if (!is_lout && !is_collect_target) {
+        return true;
+    }
+
+    // Parse layer index from tensor name: "l_out-0", "ffn_swiglu-31", etc.
+    int il = -1;
+    const char * dash = strchr(t->name, '-');
+    if (dash) {
+        il = atoi(dash + 1);
+    }
+    if (il < 0) {
+        return true;
+    }
+
+    if (t->type != GGML_TYPE_F32) {
+        return true;
+    }
+
+    // t is [dim, n_tokens] — dim is n_embd for l_out, n_ff for FFN intermediates
+    int dim      = (int)t->ne[0];
+    int n_tokens = (int)t->ne[1];
+    size_t n_bytes = (size_t)dim * n_tokens * sizeof(float);
+
+    std::vector<float> cpu_buf(dim * n_tokens);
+    ggml_backend_tensor_get(t, cpu_buf.data(), 0, n_bytes);
+
+    // Projection write-back steering: edit the residual in place and push it back
+    // to the backend buffer so downstream layers see the edited state. Only
+    // for l_out (the residual stream) at target layers; skip prefill batches
+    // unless explicitly enabled.
+    if (is_lout && g_activation_capture.steering && g_activation_capture.steer_dirs.count(il)) {
+        if (!(g_activation_capture.steer_only_ntok1 && n_tokens > 1)) {
+            if (g_activation_capture.apply_steer(il, cpu_buf.data(), dim, n_tokens)) {
+                ggml_backend_tensor_set(t, cpu_buf.data(), 0, n_bytes);
+            }
+        }
+    }
+
+    // Additive steering: h += v at target layers, written back
+    if (is_lout && g_activation_capture.add_active && g_activation_capture.add_vecs.count(il)) {
+        if (!(g_activation_capture.add_only_decode && n_tokens > 1)) {
+            if (g_activation_capture.apply_add(il, cpu_buf.data(), dim, n_tokens)) {
+                ggml_backend_tensor_set(t, cpu_buf.data(), 0, n_bytes);
+            }
+        }
+    }
+
+    // Update live monitoring means for l_out tensors only
+    if (is_lout) {
+        g_activation_capture.store_layer_mean(il, cpu_buf.data(), dim, n_tokens);
+        // Per-response accumulation: decode batches only (prefill n_tokens>1 is
+        // declined in the ask phase unless collecting; guard again here).
+        if (g_activation_capture.acc_active && n_tokens == 1) {
+            g_activation_capture.acc_add(il, cpu_buf.data(), dim, n_tokens);
+        }
+    }
+
+    // Stream to collection file if this tensor matches the collection target
+    if (g_activation_capture.collecting && (is_collect_target || (is_lout && g_activation_capture.collect_tensor.empty()))) {
+        // Patch header with actual dimension on first capture
+        if (g_activation_capture.collect_dim == 0 && dim > 0) {
+            g_activation_capture.collect_dim = dim;
+            if (is_collect_target) {
+                g_activation_capture.patch_header_dim(dim);
+            }
+        }
+        g_activation_capture.collect_tokens(il, cpu_buf.data(), dim, n_tokens);
+    }
+
+    return true;
+}
