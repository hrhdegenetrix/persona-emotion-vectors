index 1293c8640..4af45346f 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1,3 +1,4 @@
+#include "activation_capture.h"
 #include "server-context.h"
 #include "server-chat.h"
 #include "server-common.h"
@@ -1103,6 +1104,16 @@ private:
             params_base.load_progress_callback_user_data = &load_progress_text;
         }
 
+        // Activation capture: install eval callback before context creation.
+        // A registered cb_eval forces node-by-node graph evaluation (disables CUDA
+        // graphs and backend fusion), so LLAMA_NO_ACTIVATION_CAPTURE=1 skips
